{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.experiments.tsbuildinfo",
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Скрипты эксперимента запускаются Node.js 24 без сборки (снятие типов) */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["experiments/**/*.ts"]
}
